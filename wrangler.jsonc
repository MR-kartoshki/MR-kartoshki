{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mr-kartoshki",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "portfolio.iaske.net",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [{
    "name": "CONTACT_EMAIL",
    "allowed_destination_addresses": ["nikita@iaske.net"],
    "allowed_sender_addresses": ["portfolio@iaske.net"]
  }],
  "ratelimits": [{
    "name": "CONTACT_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 3, "period": 60 }
  }],
  "main": "worker.js"
}
