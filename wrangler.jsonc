{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mr-kartoshki",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js"
}
